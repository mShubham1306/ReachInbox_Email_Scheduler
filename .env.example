# ============================================================
# ReachInbox Email Scheduler — Environment Variables
# ============================================================
# Copy this file to backend/.env for local development.
# For production, set these in the Render dashboard (API + Worker services).
# For the frontend, set VITE_API_URL in the Vercel dashboard.

# -- Runtime ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# -- Frontend -----------------------------------------------------------------
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL, e.g. https://reachinbox.vercel.app
FRONTEND_URL=http://localhost:5173

# -- Database (PostgreSQL) -----------------------------------------------------
# Local dev: postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox
# Render Postgres: copy the "External Connection String" from the Render dashboard
# Neon / Supabase: use the connection string they provide (append ?sslmode=require)
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox

# -- Redis ---------------------------------------------------------------------
# Local dev: redis://localhost:6379
# Render Redis: copy the "External URL" from the Render Redis dashboard
# Upstash (free): rediss://:password@host:6380
REDIS_URL=redis://localhost:6379

# -- Elasticsearch (optional) --------------------------------------------------
# Leave blank ("") to disable — the app degrades gracefully without it.
# Elastic Cloud / Bonsai.io: https://user:password@host:port
ELASTICSEARCH_URL=http://localhost:9200

# -- Session -------------------------------------------------------------------
# CHANGE THIS in production! Use a long random string (32+ chars).
# On Render, use generateValue: true in render.yaml or set it manually.
SESSION_SECRET=reachinbox-dev-secret-change-in-production

# -- Google OAuth 2.0 ----------------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs:
#   Local:      http://localhost:5000/auth/google/callback
#   Production: https://reachinbox-api.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# -- Slack OAuth ---------------------------------------------------------------
# Create an app at: https://api.slack.com/apps
# Redirect URLs:
#   Local:      http://localhost:5000/auth/slack/callback
#   Production: https://reachinbox-api.onrender.com/auth/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/auth/slack/callback

# -- Email / SMTP --------------------------------------------------------------
# Default: Ethereal (fake SMTP for testing — run `npm run setup:ethereal` to get creds)
# Production: use a real SMTP provider (SendGrid, Mailgun, AWS SES, etc.)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# -- Worker Tuning -------------------------------------------------------------
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=100

# -- Bull Board Admin UI -------------------------------------------------------
# Access at: https://reachinbox-api.onrender.com/admin/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin123

# ============================================================
# FRONTEND (Vercel) — set in Vercel dashboard, NOT in .env
# ============================================================
# VITE_API_URL=https://reachinbox-api.onrender.com
# (Leave blank / unset for local dev — Vite proxy handles it automatically)
